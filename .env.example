# Airtable API (required for submissions list + form)
# Create a Personal Access Token at https://airtable.com/create/tokens
# with scopes: data.records:read, data.records:write
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# Table name or table ID. Table should have fields: Name, Email, Message
AIRTABLE_TABLE_NAME=Submissions
